{
  "name": "vita",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vita voice assistant — monorepo (web SDK, gateway, orchestrator, MCP, RAG)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "cross-env CI=true turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "eslint": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "prettier": "^3.3.3",
    "vitest": "^2.1.3",
    "husky": "^9.1.6"
  }
}
