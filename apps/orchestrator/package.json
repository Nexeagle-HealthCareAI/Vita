{
  "name": "@vita/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Dialogue state manager: Redis session engine, RBAC, audit log, LLM/STT/TTS/MCP/RAG orchestration",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vita/protocol": "workspace:*",
    "ioredis": "^5.4.1",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "ioredis-mock": "^8.9.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "@types/node": "^22.7.5"
  }
}
