{
  "name": "@vita/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "WS ingress: ticket auth, binary frame relay to the orchestrator",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vita/protocol": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/websocket": "^11.0.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "@types/node": "^22.7.5"
  }
}
