{
  "name": "@tera/web-sdk",
  "version": "0.1.0",
  "description": "Browser client SDK for Tera voice assistant — audio capture, playback, WS session",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/worklet/tera-pcm-processor.js dist/tera-pcm-processor.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@tera/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "jsdom": "^25.0.1",
    "@types/node": "^22.7.5"
  }
}
