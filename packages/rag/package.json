{
  "name": "@vita/rag",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid (BM25 + dense) retrieval over Qdrant -- FAQ corpus about Vita today; lab-test rules/insurance docs are future work",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
