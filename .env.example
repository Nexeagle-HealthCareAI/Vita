# --- Auth ---
JWT_SIGNING_SECRET=change-me
TICKET_TTL_SECONDS=30
# Global (not per-IP -- see rateLimiter.ts) token bucket protecting POST /session/ticket
# from a runaway client/bot/retry-loop (optional, defaults shown).
TICKET_RATE_LIMIT_CAPACITY=30
TICKET_RATE_LIMIT_REFILL_MS=2000

# --- Orchestrator: HTTP port (optional, default shown) ---
ORCHESTRATOR_PORT=8081

# --- Orchestrator: session-epoch fencing (multi-instance-gateway prep) ---
# A session's `epoch` (see apps/orchestrator/src/session.ts) increments on every resume,
# so a connection superseded by a later resume can be told to stop instead of silently
# competing with the newer one and clobbering its turns.
#
# The WRITE-time fence is always on and is the real correctness backstop -- it needs no
# configuration and no cooperation from the gateway.
#
# This flag only controls the additional ENTRY-side check (reject a stale turn before
# spending a Groq/Sarvam round trip on it). Ships dark, `=== 'true'`, default OFF, like
# PROTOCOL_VERSION_ENFORCEMENT_ENABLED rather than SESSION_RESUME_ENABLED -- a misfire
# here kills live calls, so it gets the conservative default. A request that declares no
# epoch at all is ALWAYS accepted regardless of this flag (rolling deploys, older gateway
# builds).
#
# Do not turn this on at the same time as any change that lets a resume land on a
# different gateway instance than the one holding the stale connection.
SESSION_EPOCH_ENFORCEMENT_ENABLED=false

# --- Redis (orchestrator session store) ---
REDIS_URL=redis://localhost:6379

# --- Postgres (durable audit log — docs/BUILD_GUIDE.md §6) ---
# Unset (or unreachable) leaves recordAuditEvent() as the stdout-only stub it's always
# been -- see apps/orchestrator/src/audit.ts. Local default matches docker-compose.yml's
# dev-only postgres service; prod's password comes from the deployed .env instead.
DATABASE_URL=postgres://vita:vita-dev-only@localhost:5432/vita
AUDIT_RETENTION_DAYS=365

# --- Session encryption at rest (docs/BUILD_GUIDE.md §6) ---
# Unset leaves SessionStore (apps/orchestrator/src/session.ts) storing plain JSON in Redis,
# exactly as before. Any non-empty value works -- a 64-char hex string or 32-byte base64 is
# used literally as the AES-256 key, anything else (e.g. a passphrase) is hashed down to one
# (see sessionCrypto.ts's deriveKey()). Left empty here deliberately; set a real value only
# in environments that actually need this on -- which, since DialogueSession can now carry
# a real forwarded easyHMSAPI staff bearer credential (hmsAccessToken, see ticket.ts's
# SessionClaims), is effectively EVERY environment where staff-auth tools like
# mark_appointment_arrived are in use: an unset key means that live credential sits in
# plaintext in Redis for up to the session's 30-minute idle TTL.
SESSION_ENCRYPTION_KEY=

# --- Sarvam AI ---
SARVAM_API_KEY=
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text-streaming
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech
# Per-call timeouts (all optional, defaults shown) -- bound how long a hung/slow Sarvam
# connection can freeze a live call before failing that one call instead of hanging forever.
SARVAM_STT_REQUEST_TIMEOUT_MS=10000
SARVAM_TTS_REQUEST_TIMEOUT_MS=8000

# --- Groq ---
GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions  # override only for local
# tooling (e.g. tools/load-test's mock-vendor stub) -- leave unset in every real environment
# Bounds one round's completion call (pipeline.ts calls this once per tool-round, not once
# per turn) -- optional, default shown.
GROQ_REQUEST_TIMEOUT_MS=15000
GROQ_MODEL_ADMIN=llama-3.1-8b-instant
# Used for any session whose real resolved permissions include doc_board OR ipd (Admission/
# IPD work board access) -- see pipeline.ts's modelForPermissions(), not just doc_board alone.
GROQ_MODEL_DOCTOR=llama-3.1-70b-versatile

# --- 1HMS MCP ---
# Kept as a non-functional placeholder deliberately -- the real dev easyHMSAPI is a
# shared team environment, and every /public/* call this service makes (including a real
# write, book_appointment) would silently land there if this were the default. Point at
# your own reachable easyHMSAPI instance explicitly. X-Api-Key is optional --
# PublicController allows anonymous callers, a key just lets traffic be
# identified/revoked. packages/mcp-1hms/test/hmsClient.contract.test.ts (run via `pnpm
# --filter @vita/mcp-1hms test:contract`, CI: nightly + on-demand only) defaults to the
# real shared dev instance on its own, independently of this file.
HMS_API_BASE_URL=https://api.1hms.internal
HMS_API_KEY=
# Per-call timeout (optional, default shown) -- bounds how long a hung/slow easyHMSAPI can
# freeze a live voice turn before that one call fails cleanly instead of hanging forever.
HMS_API_TIMEOUT_MS=8000

# --- Orchestrator: doctor-roster injection for LLM-assisted phonetic name correction ---
# One hospital per deployment (matches HMS_API_BASE_URL/HMS_API_KEY's own scope) -- unset =
# roster injection stays off, byte-identical to before this feature existed.
HOSPITAL_ID=
DOCTOR_ROSTER_ENABLED=true         # default ON, instant single-var rollback if needed

# Note: staff-only actions (mark_appointment_arrived and later fast-follows) need NO env
# vars of their own -- Vita never holds a credential for these. The calling staff member's
# own easyHMSAPI hospitalId + bearer JWT are forwarded per-session from easyHMSWeb (the app
# they're already logged into) via the ticket JWT's hospitalId/hmsAccessToken claims -- see
# apps/gateway/src/ticket.ts's SessionClaims and packages/mcp-1hms/src/hmsClient.ts's
# StaffAuthContext.
# Bounds the GET user/permissions call resolveSessionPermissions makes at POST /session
# time (optional, default shown) -- a session's permissions fail clean to [] (deny-by-
# default) rather than blocking session creation if this is exceeded.
HMS_PERMISSIONS_FETCH_TIMEOUT_MS=2500

# --- RAG / Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Embedding model id (optional -- Xenova/all-MiniLM-L6-v2, a 384-dim sentence-transformer,
# is the default if unset). Changing this changes the embedding dimension/semantics of
# every vector already stored in Qdrant -- re-run `pnpm --filter @vita/rag ingest` after
# changing it, don't just flip it on a live collection.
RAG_EMBED_MODEL=
QDRANT_FAQ_COLLECTION=vita_faq
QDRANT_HOSPITAL_REFERENCE_COLLECTION=vita_hospital_reference

# --- Gateway ---
GATEWAY_PORT=8080
# Plain HTTP, not ws:// -- the gateway relay (apps/gateway/src/relay.ts) segments a caller's
# speech into utterances itself and POSTs each one to the orchestrator's
# /session/:id/turn/audio route rather than opening a second WebSocket to it.
ORCHESTRATOR_INTERNAL_URL=http://localhost:8081

# --- Gateway relay: VAD-based utterance segmentation (all optional, defaults shown) ---
UTTERANCE_SILENCE_MS=700
MIN_UTTERANCE_SPEECH_MS=300
MAX_UTTERANCE_MS=20000
BARGE_IN_ENABLED=true
BARGE_IN_GRACE_MS=300

# --- Audio preprocessing service ---
AUDIO_PREPROCESS_URL=http://localhost:8090
# Per-frame call timeout (optional, default shown) -- bounds how long a hung/overloaded
# audio-preprocess instance can freeze a live call before that one frame fails cleanly
# instead of hanging forever (see apps/gateway/src/audioPreprocessClient.ts).
AUDIO_PREPROCESS_TIMEOUT_MS=2000
# Read directly by the audio-preprocess Python service itself (apps/audio-preprocess/app/
# main.py), not the gateway -- set these in that container's own environment, not here.
# All optional, defaults shown. VAD_THRESHOLD is Silero VAD's speech-probability cutoff
# (0-1) -- a noisier clinic might want a different value. The other two are this
# service's per-session model-state TTL/sweep cadence (mirrors ticket.ts's/session.ts's
# own TTL-based cleanup elsewhere in this repo). Does NOT include denoise.py's
# CONTEXT_MS, which stays a hardcoded, empirically-validated constant on purpose -- see
# that file's own docstring.
VAD_THRESHOLD=0.5
AUDIO_PREPROCESS_SESSION_TTL_SECONDS=120
AUDIO_PREPROCESS_SWEEP_INTERVAL_SECONDS=30

# --- Gateway: real-time streaming STT (see docs/BUILD_GUIDE.md streaming STT plan) ---
STREAMING_STT_ENABLED=false        # Phase 1 default OFF -- flip on per-environment only after validation
STREAM_CONNECT_TIMEOUT_MS=3000

# --- Orchestrator: Sarvam realtime STT (saaras:v3-realtime, manual endpointing) ---
SARVAM_STT_REALTIME_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_STT_LANGUAGE_CODE=en-IN
SARVAM_STT_STREAM_TYPE=fast
SARVAM_CONNECT_TIMEOUT_MS=1800
SARVAM_CONNECT_GATE_MAX_WAIT_MS=1000
SARVAM_CONNECT_BURST_CAPACITY=3
SARVAM_CONNECT_REFILL_MS=250

# --- Gateway: session resume across a dropped connection ---
SESSION_RESUME_ENABLED=true        # default ON -- instant single-var rollback if needed

# --- Gateway: protocol-version enforcement (rejects a client whose HELLO is missing or
# whose version doesn't match packages/protocol/src/events.ts's PROTOCOL_VERSION) ---
PROTOCOL_VERSION_ENFORCEMENT_ENABLED=false  # Phase 1 default OFF -- ships dark, flip on per-environment only after validation
HELLO_TIMEOUT_MS=3000
