{
  "name": "@vita/load-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only load/throughput harness for the full real Vita stack (gateway + orchestrator + audio-preprocess + Redis) -- only Sarvam/Groq are stubbed. See README.md before running.",
  "scripts": {
    "load-test": "tsx src/index.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@vita/protocol": "workspace:*",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "jsonwebtoken": "^9.0.2",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@vita/orchestrator": "workspace:*"
  }
}
